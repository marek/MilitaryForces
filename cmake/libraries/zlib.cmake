option(USE_INTERNAL_ZLIB "Use internal copy of zlib" ON)

set(ZLIB_VERSION 1.3.1)
set(INTERNAL_ZLIB_DIR ${SOURCE_DIR}/thirdparty/zlib-${ZLIB_VERSION})

if(USE_INTERNAL_ZLIB)
    file(GLOB ZLIB_SOURCES ${INTERNAL_ZLIB_DIR}/*.c)
    add_library(internal_zlib STATIC ${ZLIB_SOURCES})
    set_target_properties(internal_zlib PROPERTIES LINKER_LANGUAGE C)
    target_compile_definitions(internal_zlib PUBLIC NO_GZIP)
    target_compile_options(internal_zlib PRIVATE -w)
    target_include_directories(internal_zlib PUBLIC ${INTERNAL_ZLIB_DIR})
    list(APPEND CLIENT_LIBRARIES internal_zlib)
    list(APPEND CLIENT_INCLUDE_DIRS ${INTERNAL_ZLIB_DIR})
    list(APPEND CLIENT_DEFINITIONS NO_GZIP)
else()
    find_package(ZLIB REQUIRED)
    list(APPEND CLIENT_LIBRARIES ZLIB::ZLIB)
endif()

add_library(minizip_ioapi STATIC ${SOURCE_DIR}/qcommon/ioapi.cpp)
if(USE_INTERNAL_ZLIB)
    target_link_libraries(minizip_ioapi PUBLIC internal_zlib)
else()
    target_link_libraries(minizip_ioapi PUBLIC ZLIB::ZLIB)
endif()
list(APPEND CLIENT_LIBRARIES minizip_ioapi)
