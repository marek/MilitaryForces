find_package(SDL2 REQUIRED CONFIG)
find_package(OpenGL REQUIRED)

list(APPEND CLIENT_DEFINITIONS USE_SDL USE_ICON)

if(WIN32 AND TARGET SDL2::SDL2main)
    list(APPEND CLIENT_LIBRARIES SDL2::SDL2main)
endif()

if(TARGET SDL2::SDL2)
    list(APPEND CLIENT_LIBRARIES SDL2::SDL2)
else()
    list(APPEND CLIENT_LIBRARIES SDL2::SDL2-static)
endif()

list(APPEND RENDERER_LIBRARIES OpenGL::GL)
