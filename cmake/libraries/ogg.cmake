option(USE_CODEC_VORBIS "Ogg Vorbis support" ON)
option(USE_CODEC_OPUS "Ogg Opus support" ON)
option(USE_INTERNAL_OGG "Use internal copy of libogg" ON)

if(NOT USE_CODEC_VORBIS AND NOT USE_CODEC_OPUS)
    return()
endif()

set(OGG_VERSION 1.3.6)
set(INTERNAL_OGG_DIR ${SOURCE_DIR}/thirdparty/libogg-${OGG_VERSION})

if(USE_INTERNAL_OGG)
    file(GLOB_RECURSE OGG_SOURCES ${INTERNAL_OGG_DIR}/*.c)
    add_library(internal_ogg STATIC ${OGG_SOURCES})
    set_target_properties(internal_ogg PROPERTIES LINKER_LANGUAGE C)
    target_compile_options(internal_ogg PRIVATE -w)
    target_include_directories(internal_ogg PUBLIC ${INTERNAL_OGG_DIR}/include)
    list(APPEND CLIENT_LIBRARIES internal_ogg)
    list(APPEND CLIENT_INCLUDE_DIRS ${INTERNAL_OGG_DIR}/include)
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(OGG REQUIRED ogg)
    list(APPEND CLIENT_LIBRARIES ${OGG_LINK_LIBRARIES})
    list(APPEND CLIENT_INCLUDE_DIRS ${OGG_INCLUDE_DIRS})
endif()
