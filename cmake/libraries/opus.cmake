option(USE_INTERNAL_OPUS "Use internal copy of opus and opusfile" ON)
option(USE_VOIP "Voice chat" ON)

if(NOT USE_CODEC_OPUS)
    return()
endif()

set(OPUS_VERSION 1.5.2)
set(OPUSFILE_VERSION 0.12)
set(INTERNAL_OPUS_DIR ${SOURCE_DIR}/thirdparty/opus-${OPUS_VERSION})
set(INTERNAL_OPUSFILE_DIR ${SOURCE_DIR}/thirdparty/opusfile-${OPUSFILE_VERSION})

function(mf_find_include_dirs OUT_VAR LIBRARY_DIR)
    file(GLOB_RECURSE HEADER_FILES ${LIBRARY_DIR}/*.h)
    set(INCLUDE_DIRS "")
    foreach(HEADER_FILE IN LISTS HEADER_FILES)
        get_filename_component(HEADER_DIR ${HEADER_FILE} DIRECTORY)
        list(APPEND INCLUDE_DIRS ${HEADER_DIR})
    endforeach()
    list(REMOVE_DUPLICATES INCLUDE_DIRS)
    set(${OUT_VAR} ${INCLUDE_DIRS} PARENT_SCOPE)
endfunction()

if(USE_INTERNAL_OPUS)
    file(GLOB_RECURSE OPUS_SOURCES ${INTERNAL_OPUS_DIR}/*.c)
    file(GLOB_RECURSE OPUSFILE_SOURCES ${INTERNAL_OPUSFILE_DIR}/*.c)
    mf_find_include_dirs(OPUS_INCLUDE_DIRS ${INTERNAL_OPUS_DIR})
    mf_find_include_dirs(OPUSFILE_INCLUDE_DIRS ${INTERNAL_OPUSFILE_DIR})
    add_library(internal_opus STATIC ${OPUS_SOURCES} ${OPUSFILE_SOURCES})
    set_target_properties(internal_opus PROPERTIES LINKER_LANGUAGE C)
    target_compile_options(internal_opus PRIVATE -w)
    target_compile_definitions(internal_opus PRIVATE OPUS_BUILD HAVE_LRINTF FLOATING_POINT FLOAT_APPROX USE_ALLOCA)
    target_include_directories(internal_opus PUBLIC ${OPUS_INCLUDE_DIRS} ${OPUSFILE_INCLUDE_DIRS})
    target_link_libraries(internal_opus PUBLIC internal_ogg)
    list(APPEND CLIENT_LIBRARIES internal_opus)
    list(APPEND CLIENT_INCLUDE_DIRS ${OPUS_INCLUDE_DIRS} ${OPUSFILE_INCLUDE_DIRS})
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(OPUS REQUIRED opus)
    pkg_check_modules(OPUSFILE REQUIRED opusfile)
    list(APPEND CLIENT_LIBRARIES ${OPUS_LINK_LIBRARIES} ${OPUSFILE_LINK_LIBRARIES})
    list(APPEND CLIENT_INCLUDE_DIRS ${OPUS_INCLUDE_DIRS} ${OPUSFILE_INCLUDE_DIRS})
endif()

list(APPEND CLIENT_DEFINITIONS USE_CODEC_OPUS)

if(USE_VOIP)
    list(APPEND CLIENT_DEFINITIONS USE_VOIP)
endif()
