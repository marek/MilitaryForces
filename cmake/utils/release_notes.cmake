# Writes <DIST>/RELEASE_NOTES.md: the packages in DIST grouped by operating system, as links to the files of
# the GitHub release TAG. Run as: cmake -DDIST=<folder> -DTAG=<tag> -P release_notes.cmake
if(NOT REPOSITORY)
    set(REPOSITORY marek/MilitaryForces)
endif()
file(GLOB PACKAGES RELATIVE ${DIST} ${DIST}/militaryforces-*)
list(SORT PACKAGES)
set(NOTES "## Downloads\n")
foreach(GROUP "macOS|darwin" "Windows|windows" "Linux|linux")
    string(REPLACE "|" ";" GROUP "${GROUP}")
    list(GET GROUP 0 TITLE)
    list(GET GROUP 1 KEY)
    set(LINES "")
    foreach(PACKAGE IN LISTS PACKAGES)
        if(NOT PACKAGE MATCHES "-${KEY}")
            continue()
        endif()
        file(SIZE ${DIST}/${PACKAGE} BYTES)
        math(EXPR MB "(${BYTES} + 524288) / 1048576")
        set(KIND "")
        if(PACKAGE MATCHES "-arm\\." AND KEY STREQUAL "darwin")
            set(KIND " (Apple silicon)")
        elseif(PACKAGE MATCHES "-arm\\.")
            set(KIND " (ARM 64-bit)")
        elseif(PACKAGE MATCHES "-x86\\.")
            set(KIND " (Intel / AMD 64-bit)")
        endif()
        if(PACKAGE MATCHES "\\.deb$")
            string(APPEND KIND ", Debian / Ubuntu package")
        endif()
        string(APPEND LINES "- [${PACKAGE}](https://github.com/${REPOSITORY}/releases/download/${TAG}/${PACKAGE})${KIND}, ${MB} MB\n")
    endforeach()
    if(LINES)
        string(APPEND NOTES "\n### ${TITLE}\n\n${LINES}")
    endif()
endforeach()
file(WRITE ${DIST}/RELEASE_NOTES.md "${NOTES}")
