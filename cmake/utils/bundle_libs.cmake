# bundle_libs.cmake: run with -DFOLDER=<the folder holding the executable and renderer libraries> -DSIGN=<identity>
# -DSEARCH=<folders to look in for @rpath libraries, separated by |>
#
# Copies every dynamic library the game needs that is not part of macOS into that same folder, and points the
# executable, the renderers and the copies at each other there, so the game runs on a machine with nothing
# installed. Libraries the copies need in turn are brought along too.

string(REPLACE "|" ";" SEARCH "${SEARCH}")
file(GLOB BINARIES "${FOLDER}/*")
set(PENDING ${BINARIES})
set(SEEN "")
while(PENDING)
    list(POP_FRONT PENDING BINARY)
    if(IS_DIRECTORY "${BINARY}" OR BINARY IN_LIST SEEN)
        continue()
    endif()
    list(APPEND SEEN "${BINARY}")
    execute_process(COMMAND otool -L "${BINARY}" OUTPUT_VARIABLE LISTING ERROR_QUIET RESULT_VARIABLE FAILED)
    if(FAILED)
        continue()
    endif()
    string(REPLACE "\n" ";" LINES "${LISTING}")
    foreach(LINE IN LISTS LINES)
        if(NOT LINE MATCHES "^[ \t]+([^ ]+\\.dylib) \\(")
            continue()
        endif()
        set(WANTED "${CMAKE_MATCH_1}")
        if(WANTED MATCHES "^(/usr/lib/|/System/|@loader_path/|@executable_path/)")
            continue()
        endif()
        get_filename_component(NAME "${WANTED}" NAME)
        set(SOURCE "${WANTED}")
        if(WANTED MATCHES "^@rpath/")
            # look where the build found its libraries
            set(SOURCE "")
            foreach(DIR IN LISTS SEARCH)
                if(EXISTS "${DIR}/${NAME}")
                    set(SOURCE "${DIR}/${NAME}")
                    break()
                endif()
            endforeach()
        endif()
        if(NOT SOURCE OR NOT EXISTS "${SOURCE}")
            message(WARNING "bundle: cannot find ${WANTED} needed by ${BINARY}")
            continue()
        endif()
        if(NOT EXISTS "${FOLDER}/${NAME}")
            get_filename_component(REAL "${SOURCE}" REALPATH)
            file(COPY_FILE "${REAL}" "${FOLDER}/${NAME}")
            file(CHMOD "${FOLDER}/${NAME}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
            execute_process(COMMAND install_name_tool -id "@loader_path/${NAME}" "${FOLDER}/${NAME}" ERROR_QUIET)
            list(APPEND PENDING "${FOLDER}/${NAME}")
            message(STATUS "bundle: ${NAME}")
        endif()
        execute_process(COMMAND install_name_tool -change "${WANTED}" "@loader_path/${NAME}" "${BINARY}" ERROR_QUIET)
    endforeach()
endwhile()

# changing a library invalidates its signature
file(GLOB LIBRARIES "${FOLDER}/*.dylib")
foreach(LIBRARY IN LISTS LIBRARIES)
    execute_process(COMMAND codesign --force --sign "${SIGN}" "${LIBRARY}" ERROR_QUIET)
endforeach()
