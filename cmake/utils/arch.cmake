if(DEFINED ARCH)
    return()
endif()

if(CMAKE_OSX_ARCHITECTURES)
    list(LENGTH CMAKE_OSX_ARCHITECTURES OSX_ARCH_COUNT)
    if(OSX_ARCH_COUNT GREATER 1)
        set(ARCH universal)
    else()
        set(ARCH ${CMAKE_OSX_ARCHITECTURES})
    endif()
else()
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" SYSTEM_PROCESSOR)
    if(SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64)$")
        set(ARCH x86_64)
    elseif(SYSTEM_PROCESSOR MATCHES "^(i.86|x86)$")
        set(ARCH x86)
    elseif(SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
        set(ARCH arm64)
    else()
        set(ARCH ${SYSTEM_PROCESSOR})
    endif()
endif()

if(ARCH STREQUAL "x86_64" AND CMAKE_SIZEOF_VOID_P EQUAL 4)
    set(ARCH x86)
endif()
